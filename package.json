{
  "name": "@anentrypoint/research",
  "version": "1.1.0",
  "description": "CLI tools for claude.ai research prompts, gitingest-based repo research, and Gemini image generation over curl-impersonate (cuimp)",
  "type": "commonjs",
  "engines": {
    "bun": ">=1.0",
    "node": ">=18"
  },
  "bin": {
    "research": "./research.js",
    "research-from-repo": "./research-from-repo.js",
    "retrieve": "./retrieve.js",
    "refresh-auth": "./refresh-auth.js",
    "refresh-gemini-auth": "./refresh-gemini-auth.js",
    "gemini-image": "./gemini-image.js"
  },
  "scripts": {
    "research": "bun research.js",
    "research-from-repo": "bun research-from-repo.js",
    "retrieve": "bun retrieve.js",
    "refresh-auth": "bun refresh-auth.js",
    "refresh-gemini-auth": "bun refresh-gemini-auth.js",
    "gemini-image": "bun gemini-image.js",
    "test": "node --test gemini-client.test.mjs"
  },
  "keywords": [
    "claude",
    "gemini",
    "ai",
    "research",
    "image-generation",
    "cuimp",
    "curl-impersonate",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "cuimp": "^2.1.1",
    "node-tls-client": "^2.1.0"
  },
  "trustedDependencies": [
    "koffi"
  ]
}
